<nav class="toc">
  <br>
  <h1 class="toc-title">Contents</h1>
  <br>
  {% for section in collections.book | groupBySectionOrder %}
    {% if section.tocNested %}
      <div class="divider"></div>
      <h3>{{ section.title }}</h3>
      
      {% for chapter in section.chapters %}
        {# Skip rendering if the chapter title is "Preface" or "Colophon" #}
        {% if chapter.data.title != "Preface" and chapter.data.title != "Colophon" %}
          <div style="margin-bottom: 5px;">
            <a href="#{{ chapter | fileId }}">{{ chapter.data.title }}<i>{{" "}}{{"/ "}}{{ chapter.data.name }}</i></a>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}

      {% for chapter in section.chapters %}
        {# Skip rendering if the chapter title is "Preface" or "Colophon" #}
        {% if chapter.data.title != "Preface" and chapter.data.title != "Colophon" %}
          <div style="margin-bottom: 5px;">
            <a href="#{{ chapter | fileId }}">{{ chapter.data.title }}</a>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
</nav>